SECRET_KEY=<secret-key>
DATABASE_URL=<db-url>
# Google Sign-In (optional — must match OAuth client used by the frontend)
GOOGLE_CLIENT_ID=
# smallcase Gateway (optional — broker connect + holdings import)
SMALLCASE_GATEWAY_NAME=
SMALLCASE_GATEWAY_API_SECRET=
SMALLCASE_GATEWAY_JWT_SECRET=

# GCS logo bucket (scripts/logos-to-cdn-bucket/logos-to-cdn-bucket.py)
GCS_BUCKET_NAME=finto-logos
GCS_PROJECT_ID=finto-477904

# Cloudflare R2 logo bucket — free-tier CDN (scripts/logos-to-cdn-bucket/logos-to-cdn-bucket.py)
# Create an R2 bucket at dash.cloudflare.com → R2 → Create bucket
# Then generate an API token with Object Read & Write permissions
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=finto-logos
# Optional: public domain (e.g. your-bucket.your-subdomain.r2.dev or a custom domain)
CLOUDFLARE_R2_PUBLIC_DOMAIN=

# US stocks data-engineering demo (src/demo_us_stocks_data_engineering)
# Symbols the producer subscribes to; alert rules are restricted to this list
DEMO_US_STOCK_SYMBOLS=AAPL,TSLA,NVDA,MSFT,AMZN,GOOGL,META
# Redpanda from docker-compose.demo-us-stocks.yml (make demo-us-stocks-infra-up)
DEMO_US_STOCK_KAFKA_BOOTSTRAP_SERVERS=localhost:19092
DEMO_US_STOCK_KAFKA_TOPIC=demo-market-prices
# TimescaleDB from the same compose file — ticks, OHLCV bars, rules and alerts.
# Published on host port 5433 so it cannot collide with a local PostgreSQL.
# From inside a container on that compose network use timescaledb:5432 instead.
TIMESCALE_DATABASE_URL=postgresql://arthik:arthik@localhost:5433/arthik_timeseries
# Alpaca market data (optional — producer simulates prices when these are unset)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex
# Force simulated prices even when Alpaca credentials are set
DEMO_US_STOCK_SIMULATE=false
DEMO_US_STOCK_SIMULATE_TICK_SECONDS=1.0